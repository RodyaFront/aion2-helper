{
  "name": "aion-boss-tracker",
  "productName": "AionBossTracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Локальный трекер полевых боссов AION 2 (Verteron / Lamuatan)",
  "author": "Rodion",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron:dev": "concurrently -k \"nuxt dev --host 127.0.0.1 --port 3000\" \"wait-on http://127.0.0.1:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "build:watcher": "dotnet publish electron/native/boss-kill-watcher/BossKillWatcher.csproj -c Release -r win-x64 --self-contained true -o electron/native/boss-kill-watcher/publish",
    "electron:build": "npm run piper:fetch && npm run build:watcher && nuxt generate && electron-builder --win portable dir && node scripts/copy-dist.mjs",
    "piper:fetch": "node scripts/fetch-piper.mjs",
    "map:scrape": "node scripts/scrape-verteron-map.mjs && node scripts/build-verteron-coords.mjs",
    "map:coords": "node scripts/build-verteron-coords.mjs",
    "map:scrape:altgard": "node scripts/scrape-altgard-map.mjs && node scripts/build-altgard-coords.mjs",
    "map:coords:altgard": "node scripts/build-altgard-coords.mjs",
    "items:scrape": "node scripts/scrape-dbaion2-items.mjs && node scripts/merge-item-page-verteron.mjs",
    "items:catalog": "node scripts/build-item-catalog.mjs",
    "items:drop-index": "node scripts/build-item-drop-index.mjs",
    "items:drop-index:altgard": "node scripts/build-item-drop-index.mjs --region=altgard",
    "items:gather-index": "node scripts/build-item-gather-index.mjs",
    "items:gather-index:altgard": "node scripts/build-item-gather-index.mjs --region=altgard",
    "items:shared45": "node scripts/build-shared-level-45.mjs",
    "items:shared45:altgard": "node scripts/build-shared-level-45.mjs --region=altgard",
    "fetch:images": "python ../scripts/fetch-boss-images.py",
    "sounds:generate": "python scripts/generate-alert-sounds.py",
    "sounds:validate": "python scripts/validate-alert-sounds.py",
    "sounds": "npm run sounds:generate && npm run sounds:validate",
    "icons:generate": "python scripts/generate-app-icon.py",
    "races:icons": "node scripts/fetch-race-icons.mjs"
  },
  "devDependencies": {
    "@lucide/vue": "^1.55.0",
    "@pinia/nuxt": "^1.0.2",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "nuxt": "^4.6.1",
    "pinia": "^4.0.3",
    "typescript": "^7.0.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.aion.bosstracker",
    "productName": "AionBossTracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/native/boss-kill-watcher/bin/**",
      "!electron/native/boss-kill-watcher/obj/**",
      "!electron/native/boss-kill-watcher/vendor/**",
      "!electron/native/boss-kill-watcher/publish/**",
      ".output/public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/piper",
        "to": "piper",
        "filter": [
          "**/*",
          "!**/*.zip",
          "!**/*.part"
        ]
      },
      {
        "from": "electron/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/native/boss-kill-watcher/publish",
        "to": "boss-kill-watcher",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      }
    ],
    "asar": true,
    "compression": "store",
    "win": {
      "icon": "electron/icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AionBossTracker.exe"
    },
    "portable": {
      "unpackDirName": "AionBossTrackerPortable"
    }
  }
}
